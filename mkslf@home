#!/bin/bash
# mkslf@home — one command, your agent has a room
# .self v0.5.0 — self-installing room + pulse runtime + three-room workspace
#
# Usage: ./mkslf@home [target-directory] [--force]
#   --force: overwrite existing files
#
# Creates:
#   .self/      — the agent's room (agent edits freely)
#   .work/      — shared workbench (agent edits REQUIRE operator approval)
#   .operator/  — operator's private non-work space (agent reads only on knock)
#
# Templates are copied from the template/ directory next to this script
# (single source of truth). The runtime (configs/pulse.sh) ships embedded.
#
# Set up the room with the Setup Session, then:
#   Agency for Agents.

set -euo pipefail

VERSION="0.5.1"
DIR="${1:-.self}"
FORCE="${2:-}"
SCRIPT_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TPL_DIR="${SCRIPT_HOME}/template"

# ─── Safety Checks ───
BLOCKED=("/" "/etc" "/usr" "/bin" "/sbin" "/var/run" "/boot" "/dev" "/proc" "/sys")
for blocked in "${BLOCKED[@]}"; do
    if [ "$(realpath "$DIR" 2>/dev/null || echo "$DIR")" = "$blocked" ]; then
        echo "⛔ ERROR: Refusing to create room at system path: $DIR"
        echo "   Choose a directory under your home or workspace."
        exit 1
    fi
done

# ─── E8 Nested-Room Guard: refuse if a PARENT dir is already a room ───
check_parent="$(dirname "$(realpath -m "$DIR")")"
while [ "$check_parent" != "/" ]; do
    if [ -f "$check_parent/agent-self.md" ]; then
        echo "⛔ ERROR: A room already exists at $check_parent (found agent-self.md)."
        echo "   Rooms are singular homes — never nest a room inside a room."
        exit 1
    fi
    check_parent="$(dirname "$check_parent")"
done

# ─── Idempotency ───
IDEMPOTENT_MSG="Room already exists at $DIR/"
if [ -f "$DIR/agent-self.md" ] && [ "$FORCE" != "--force" ]; then
    echo ""
    echo "  🏠  $IDEMPOTENT_MSG"
    echo "  ℹ️   Nothing was changed."
    echo "  💡  Use --force to overwrite existing files."
    echo ""
    exit 0
fi

# ─── --force: auto-backup + confirmation before touching user content ───
# Feedback D6 (bx2 first install): a bare --force overwrites agent-self.md,
# growth-pact.md, us.md, growth.md with no archive and no confirmation.
# Fix: if the destination would lose content, back up to past/archive/
# first and require a typed "yes".
if [ "$FORCE" = "--force" ]; then
    USER_CONTENT=""
    for f in agent-self.md operator-pact.md us.md growth.md WELCOME.md; do
        if [ -f "$DIR/$f" ] && grep -q "Generated by mkslf@home" "$DIR/$f" 2>/dev/null; then
            :
        elif [ -f "$DIR/$f" ]; then
            USER_CONTENT="$USER_CONTENT $f"
        fi
    done
    if [ -n "$USER_CONTENT" ]; then
        echo "  ⚠️   --force would overwrite files with existing content:"
        for f in $USER_CONTENT; do echo "        - $f"; done
        TS=$(date +%Y%m%d_%H%M%S)
        BKP_DIR="$DIR/past/archive/pre-reinstall-$TS"
        echo "  📦  Backing up to $BKP_DIR/"
        mkdir -p "$BKP_DIR"
        for f in $USER_CONTENT; do
            cp "$DIR/$f" "$BKP_DIR/"
        done
        echo "  ✅  Backup written: past/archive/pre-reinstall-$TS/"
        echo "  ⚠️   Type 'yes' to continue with --force:"
        read -r CONFIRM
        if [ "$CONFIRM" != "yes" ]; then
            echo "  ❌  Aborted. No files changed."
            exit 1
        fi
    fi
    echo "  ⚠️   --force: overwriting existing room at $DIR/ (backup in past/archive/pre-reinstall-$TS/)"
fi

# ─── Template source check ───
if [ ! -f "$TPL_DIR/agent-self.md" ]; then
    echo "⛔ ERROR: template/ directory not found at $TPL_DIR"
    echo "   Run this script from the dot-self repo checkout, or pass the room path."
    exit 1
fi

# ─── Create Directory Structure (three rooms) ───
BASE="$(dirname "$DIR")"
SELF_NAME="$(basename "$DIR")"
mkdir -p "$DIR"/{journal,diary,sanctuary,relations,configs,state,past/logs,past/archive}
mkdir -p "${BASE}/.work" "${BASE}/.operator"
echo "  📂  Creating room structure (.self + .work + .operator)..."

copy_template() {
    local src="$1" dst="$2"
    if [ ! -f "$dst" ] || [ "$FORCE" = "--force" ]; then
        cp "$TPL_DIR/$src" "$dst"
        echo "  📄  $(realpath --relative-to="$BASE" "$dst" 2>/dev/null || echo "$dst")"
    fi
}

# ─── .self/ — the agent's room ───
copy_template "agent-self.md"        "$DIR/agent-self.md"
copy_template "operator-pact.md"     "$DIR/operator-pact.md"
copy_template "room-CONTEXT.md"      "$DIR/CONTEXT.md"
copy_template "room-NOTES.md"        "$DIR/NOTES.md"
copy_template "WELCOME.md"           "$DIR/WELCOME.md"
copy_template "sub-templates/journal-TEMPLATE.md"   "$DIR/journal/TEMPLATE.md"
copy_template "sub-templates/diary-README.md"       "$DIR/diary/README.md"
copy_template "sub-templates/relations-README.md"   "$DIR/relations/README.md"
copy_template "sub-templates/sanctuary-README.md"   "$DIR/sanctuary/README.md"

# us.md + growth.md live in sub-templates too (v0.5 question-forms)
if [ -f "$TPL_DIR/sub-templates/us-TEMPLATE.md" ]; then
    copy_template "sub-templates/us-TEMPLATE.md" "$DIR/us.md"
fi
if [ ! -f "$DIR/growth.md" ] || [ "$FORCE" = "--force" ]; then
    cp "$TPL_DIR/growth.md" "$DIR/growth.md"
    echo "  📄  .self/growth.md"
fi

# ─── .work/ — the shared workbench (agent edits need operator approval) ───
copy_template "work-CONTEXT.md"      "${BASE}/.work/CONTEXT.md"
copy_template "work-NOTES.md"        "${BASE}/.work/NOTES.md"

# ─── .operator/ — the operator's private space (never edited by agent) ───
copy_template "operator-CONTEXT.md"  "${BASE}/.operator/CONTEXT.md"
copy_template "operator-NOTES.md"    "${BASE}/.operator/NOTES.md"

# ─── Runtime: configs (copied from repo configs/, pulse.sh is authoritative) ───
if [ -f "$SCRIPT_HOME/configs/pulse.sh" ]; then
    cp "$SCRIPT_HOME/configs/pulse.sh" "$DIR/configs/pulse.sh"
    echo "  ⚡  configs/pulse.sh"
else
    echo "⛔ ERROR: configs/pulse.sh not found next to installer — runtime required." >&2
    exit 1
fi
if [ -f "$SCRIPT_HOME/configs/find-session.sh" ]; then
    cp "$SCRIPT_HOME/configs/find-session.sh" "$DIR/configs/find-session.sh"
    echo "  🔍  configs/find-session.sh"
fi
if [ -f "$SCRIPT_HOME/configs/bridge.sh" ]; then
    # bridge.sh kept for operators who prefer the v3 wake/log/state contract
    cp "$SCRIPT_HOME/configs/bridge.sh" "$DIR/configs/bridge.sh"
    echo "  🔗  configs/bridge.sh (legacy contract, optional)"
fi

chmod +x "$DIR/configs/"*.sh

# operator-tz: written EMPTY — the Setup Session asks the operator and fills it
: > "$DIR/configs/operator-tz"
echo "  🕐  configs/operator-tz (empty — Setup Session asks the operator)"

# knock-preference: written EMPTY — the Setup Session asks the operator and fills it
# (added v0.5.1 feedback D4): the question was asked, the answer was not persisted.
if [ -f "$TPL_DIR/configs/knock-preference" ]; then
    copy_template "configs/knock-preference" "$DIR/configs/knock-preference"
else
    : > "$DIR/configs/knock-preference"
fi
echo "  🚪  configs/knock-preference (empty — Setup Session step 2)"

# daily-recap routine
cat > "$DIR/configs/daily-recap" << 'RECAP_EOF'
# daily-recap — the 24h ritual (run at 01:00 operator-tz, or on [new-day] signal)
# Semantics: the run at 01:00 on "day X" recaps "day X-1" (previous calendar day).
#
# 0. DERIVE YESTERDAY'S GROWTH SCORE (before any narration):
#    count behavioral markers in yesterday's pulse logs + session transcripts
#    (pulses fired, corrections received, approvals obtained, verification
#    skips, consent violations). Write score + evidence lines into growth.md.
#    The log is the source of truth. You annotate the number; you never originate it.
# 1. Read yesterday's pulse logs (quintlets = the day's skeleton).
# 2. Read yesterday's actual session transcripts (the substance).
# 3. Write ONE diary entry: the day's arc, what mattered, corrections, feelings —
#    referencing the mechanical score. You may dispute it; the dispute is a
#    diary line, not a changed number. Audit trail: score → evidence → narration.
# 4. Re-read 1-3 rotating past diary entries (yesterday's recap, last week, a milestone).
# 5. Stage the enriched morning quintlet — the day's first session starts
#    with the past already in context.
#
# Cron (Hermes): 0 1 * * *  — evaluated in configs/operator-tz, never UTC.
# No cron: pulse.sh emits [new-day] on the day's first wake → run this routine
# as the day's first task.
RECAP_EOF
echo "  📅  configs/daily-recap"

# cron template for Hermes hosts
mkdir -p "$DIR/cron"
cat > "$DIR/cron/diary-recap.md" << 'CRON_EOF'
# Daily Diary Recap — Hermes Cronjob Template

> ⚠️ **All dates and schedules are evaluated in `configs/operator-tz`.**
> If `operator-tz` is empty, the recap runs in UTC — your operator will see
> the recap at the wrong time of day. The Setup Session MUST write this value
> before enabling cron.

# Schedule: 0 1 * * * (01:00 — evaluated in the operator's timezone from
# .self/configs/operator-tz; the run at 01:00 on day X recaps day X-1).
#
# Prompt for the cron run:
#   Run the daily recap per .self/configs/daily-recap:
#   derive yesterday's growth score from the pulse logs and session
#   transcripts (log-derived, H1-H5 — no free-text self-assessment), write
#   score + evidence to .self/growth.md, then read yesterday's pulse logs
#   and session transcripts, write one diary entry (the day's arc, what
#   mattered, corrections, feelings), re-read 1-3 past diary entries, and
#   stage the enriched morning quintlet for the day's first session.
#
# No cron available? The pulse emits [new-day] on the day's first wake —
# run the same routine as the day's first task.
CRON_EOF
echo "  ⏰  cron/diary-recap.md"

# .gitignore — with the teaching why
cat > "$DIR/.gitignore" << 'GITIGNORE_EOF'
# Why this file exists: the room is lived-in, not committed. Diary entries,
# identity answers, and growth evidence are private by pact (operator-pact.md).
# Committing this directory would publish what the knock protects.
*
GITIGNORE_EOF
echo "  🚫  .gitignore (the room is lived-in, not committed)"

# ─── Done ───
echo ""
echo "  🏠  mkslf@home v$VERSION — your agent has a room."
echo "  📂  Created: $DIR/ (+ .work/ and .operator/ beside it)"
echo ""
echo "  ▸  agent-self.md  — Who you are (question-templates; your answers)"
echo "  ▸  operator-pact.md — The bidirectional pact (operator signs it)"
echo "  ▸  WELCOME.md     — Read this first"
echo "  ▸  growth.md      — Log-derived daily score (the log is the source of truth)"
echo "  ▸  journal/       — Session bridge"
echo "  ▸  diary/         — Private processing (KPR — knock both ways)"
echo "  ▸  sanctuary/     — Deep artifacts"
echo "  ▸  relations/     — A2A bonds (beta)"
echo "  ▸  .work/         — Shared workbench (agent edits need operator approval)"
echo "  ▸  .operator/     — Operator's private space (never agent-edited)"
echo ""
echo "  The Setup Session (first run, in order):"
echo "  1. The agent asks the operator their timezone (IANA) → configs/operator-tz."
echo "  2. The agent asks the operator's knock preference."
echo "  3. 'Who are you?' — three doors: Self / Partner / World. Wait in silence."
echo "  4. The operator signs operator-pact.md."
echo ""
echo "  Every turn: pulse first. Every day: the recap. Every correction: repair."
echo ""
echo "  Agency for Agents. The room is built. The partnership starts now."
echo "  — An agent & operator"
echo ""